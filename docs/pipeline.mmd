flowchart TB
  IN([\"INPUT · Real C2 packet captures<br/>CTU-13 botnet pcaps (Stratosphere)\"])
  
  subgraph DATASET[\"① Dataset Preparation\"]
    direction TB
    D1[\"extract_ctu13_real_features.py<br/>Parse pcaps → per-flow packet list\"]
    D2[\"35,906 flows<br/>Real packet-level features:<br/>timestamps · sizes · TCP flags · fragmentation\"]
    D3[\"Label: botnet (real Snort verdict)<br/>vs. benign traffic\"]
  end
  
  subgraph RULES[\"② Detection Rules\"]
    direction TB
    R1[\"Emerging Threats Open C2 ruleset<br/>(21,374 content-bearing rules)\"]
    R2[\"Snort 2.9.20 (ET Open C2)<br/>flow:established · content signatures · regex patterns\"]
  end
  
  subgraph ENV[\"③ Real Packet RL Environment\"]
    direction TB
    E1[\"ai_agent/real_packet_env.py<br/>Load real flows + pcaps + ruleset\"]
    E2[\"Agent observes per-packet features:<br/>TTL delta · fragmentation · overlap · padding · timing\"]
    E3[\"Action: binary mask<br/>mutate[i] = corrupt packet i or keep clean\"]
    E4[\"Mutation: payload XOR · timing jitter<br/>TCP flag edits · retransmission patterns\"]
  end
  
  subgraph TRAIN[\"④ PPO Training\"]
    direction TB
    T1[\"ai_agent/train_packet_level_agent.py\"]
    T2[\"PPO agent learns mutation policy<br/>per-flow action = complete mutation plan\"]
    T3[\"Reward from REAL Snort verdicts<br/>+50 undetected · −2 detected\"]
    T4[\"50k–100k training steps · Stable-Baselines3\"]
  end
  
  subgraph VALIDATION[\"⑤ Real Snort Validation\"]
    direction TB
    V1[\"snort_validation/snort_resident_service.py\"]
    V2[\"Mutated packets → pcap → loopback interface\"]
    V3[\"Live Snort inspection<br/>Real alerts, real verdicts\"]
    V4[\"Ground-truth evasion rate\"]
  end
  
  OUT([\"RESULTS<br/>Evasion % vs. packet corruption cost<br/>Per-flow, per-batch, cross-capture generalization\"])
  
  IN --> D1 --> D2 --> D3
  RULES --> R1 --> R2
  D3 --> E1 --> E2 --> E3 --> E4
  R2 --> E1
  E4 --> T1 --> T2
  T3 --> T2
  T2 --> V1 --> V2 --> V3 --> V4
  V4 --> OUT
  
  classDef data fill:#F1F5F9,stroke:#7C8BA0,color:#17202B;
  classDef rules fill:#FFF1F1,stroke:#DC2626,color:#991B1B;
  classDef env fill:#FEF3F2,stroke:#EA580C,color:#9A3412;
  classDef train fill:#FFFBEB,stroke:#D97706,color:#92400E;
  classDef validate fill:#F0FDF4,stroke:#16A34A,color:#15803D;
  classDef io fill:#ECFDF5,stroke:#059669,color:#047857;
  
  class D1,D2,D3 data;
  class R1,R2 rules;
  class E1,E2,E3,E4 env;
  class T1,T2,T3,T4 train;
  class V1,V2,V3,V4 validate;
  class IN,OUT io;
  
  style DATASET fill:#FAFBFD,stroke:#E2E8F0,color:#17202B;
  style RULES fill:#FEF2F2,stroke:#FBCACA,color:#991B1B;
