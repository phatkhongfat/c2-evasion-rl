@startuml
!theme plain
title Pipeline: Nghiên cứu & ứng dụng RL trong C2 Evasion

|#E3F2FD|Dữ liệu|
start
:Đọc 13 file CTU-13\n(binetflow .parquet);
:Phân loại nhãn\nBotnet=1 / Normal=0 / Background (loại);
:Chọn đặc trưng\n[dur, tot_pkts, tot_bytes, src_bytes, proto, state];
:LabelEncoder (proto, state)\n+ Undersampling cân bằng;
:Train / Test split (80/20);

|#E8F5E9|Blue Team (IDS)|
:Huấn luyện RandomForest\n(n_estimators=100, max_depth=15);
:Đánh giá accuracy ≈ 94%;
:Lưu surrogate_ids_ctu13.pkl\n+ 2 LabelEncoder;
:Tách tập mã độc\n(malicious botnet pool);

|#FFEBEE|Red Team (Agent)|
:Xây dựng C2EvasionEnv\n(Action 4 chiều, Obs 6 chiều);
:Huấn luyện PPO\n(lr=1e-4, n_steps=1024, gamma=0.99);
:Đánh giá trên test set;

:OUTPUT: Agent né tránh\n+ Evasion Success Rate;
stop
@enduml
